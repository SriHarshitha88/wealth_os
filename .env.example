# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — used by the cron job to write prices. Never expose to the browser.

# ---- Twelve Data (twelvedata.com — free, no broker account) ----
TWELVEDATA_API_KEY=                 # sign up, copy the API key from your dashboard

# ---- Cron protection ----
CRON_SECRET=                        # any long random string

# ---- Google Gemini (AI Copilot) ----
GEMINI_API_KEY=                     # free key from aistudio.google.com/apikey (model: gemini-flash-latest)
